# One-off shipping workaround: identical to the runtime stage of ./Dockerfile,
# but COPYs a host-built dist/ instead of compiling inside Docker (buildkit was
# dropping the connection on long RUN steps — see docs/troubleshooting.md).
# Build:  docker build -f Dockerfile.prebuilt -t oracle-dataforge:latest .
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json* ./
RUN npm install --omit=dev
COPY dist ./dist
COPY server ./server
# same as ./Dockerfile: run unprivileged, own the data/ mount point
RUN mkdir -p /app/data && chown -R node:node /app
USER node
EXPOSE 3001
CMD ["npx", "tsx", "server/index.ts"]
