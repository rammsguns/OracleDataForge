# Backend listener. Loopback is the secure default. LAN access requires both secrets below.
HOST=127.0.0.1
PORT=3001

# Required whenever HOST is not loopback. Use a long random value; browsers prompt once.
# DATAFORGE_AUTH_TOKEN=

# Required whenever HOST is not loopback. Generate with: openssl rand -base64 32
# It encrypts saved Oracle credentials with AES-256-GCM. Keep this stable and secret.
# DATAFORGE_ENCRYPTION_KEY=

# Optional GitHub fine-grained token. Give it Contents: Read and write access only to
# the repository you connect in Dataforge (for example rammsguns/PLSQL). Never expose it in the browser.
# GITHUB_TOKEN=

# Use production when serving the built SPA from the backend.
NODE_ENV=development
