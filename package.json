{
  "name": "oracle-dataforge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --import tsx --test server/connectionExport.test.ts server/connectionRole.test.ts server/oracleWallet.test.ts server/objectCopy.test.ts",
    "dev:server": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "lucide-react": "^0.469.0",
    "oracledb": "^7.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/oracledb": "7.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "oracledb@7.0.1": true
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
